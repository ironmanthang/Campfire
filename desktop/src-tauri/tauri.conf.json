{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campfire",
  "version": "0.1.0",
  "identifier": "com.pastyou.app",
  "build": {
    "beforeDevCommand": "cd src-tauri && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd src-tauri && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Campfire",
        "width": 800,
        "height": 600,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
