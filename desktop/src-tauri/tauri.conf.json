{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campfire Journal",
  "version": "0.1.7",
  "identifier": "happyKnight.CampfireJournal",
  "build": {
    "beforeDevCommand": "cd src-tauri && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd src-tauri && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Campfire Journal",
        "width": 800,
        "height": 600,
        "maximized": true,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https: ipc: http://ipc.localhost http://localhost:11434 http://127.0.0.1:11434; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
