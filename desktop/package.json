{
  "name": "desktop",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tsc && vite build && pnpm exec javascript-obfuscator dist/assets --output dist/assets --compact true --control-flow-flattening true --string-array true --string-array-encoding base64",
    "release": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "i18n:check": "node scripts/i18n-check.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "tauri:windows:build": "pnpm tauri build --target x86_64-pc-windows-msvc && tauri-windows-bundle build --runner pnpm && node scripts/sign-msix.js && node scripts/run-wack.js"
  },
  "dependencies": {
    "@campfire/core": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.3.6",
    "lucide-react": "^1.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.28",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "javascript-obfuscator": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
